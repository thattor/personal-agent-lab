+                "invalid_input",
+                "content must be a string",
+            )
+        self.assert_error(
+            payload("aGVsbG8=", 5, drop=("content",)),
+            "invalid_input",
+            "content must be a string",
+        )
+
+    def test_t19_size_field(self):
+        for value in (None, -1, 1.0, True, "5", [5]):
